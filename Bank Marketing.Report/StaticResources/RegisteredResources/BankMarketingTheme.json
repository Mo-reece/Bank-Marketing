{
  "name": "BankMarketingTheme",
  "dataColors": [
    "#12385A",
    "#E8A33D",
    "#2E7D8F",
    "#A3B5C0",
    "#7B4B94",
    "#4C8C5A",
    "#C4553B",
    "#5A6B75",
    "#2F5F84",
    "#F0C27B",
    "#4FA3B5",
    "#C7D3DB"
  ],
  "background": "#FFFFFF",
  "foreground": "#1B2A33",
  "tableAccent": "#12385A",
  "good": "#4C8C5A",
  "neutral": "#A3B5C0",
  "bad": "#C4553B",
  "maximum": "#12385A",
  "center": "#A3B5C0",
  "minimum": "#EDF2F5",
  "textClasses": {
    "title": {
      "fontSize": 15,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F2A3F"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F2A3F"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#33454F"
    },
    "callout": {
      "fontSize": 30,
      "fontFace": "Segoe UI Semibold",
      "color": "#12385A"
    },
    "largeTitle": {
      "fontSize": 20,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F2A3F"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DCE4EA"
              }
            },
            "radius": 6
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0F2A3F"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "alignment": "left",
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#33454F"
              }
            },
            "fontSize": 9
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#33454F"
              }
            },
            "fontSize": 9,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#33454F"
              }
            },
            "fontSize": 9,
            "gridlineColor": {
              "solid": {
                "color": "#EDF2F5"
              }
            }
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#33454F"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F7F9"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#E9EEF2"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#12385A"
              }
            },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#5A6B75"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "*": [
          {
            "$id": "default",
            "paddingUniform": 10,
            "backgroundTransparency": 100
          }
        ]
      }
    }
  }
}
