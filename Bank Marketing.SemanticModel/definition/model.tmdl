model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup '01 Parameters'

	annotation PBI_QueryGroupOrder = 0

queryGroup '02 Staging'

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

annotation PBI_QueryOrder = ["DataFolder","CampaignContactsRaw","CampaignPeriods","UgandaIndicatorsRaw","FactCampaignContact","DimDate","DimJob","DimEducation","DimAgeBand","FactUgandaIndicator","DimUgandaMonth","DimIndicator","_Measures"]

ref table FactCampaignContact
ref table DimDate
ref table DimJob
ref table DimEducation
ref table DimAgeBand
ref table FactUgandaIndicator
ref table DimUgandaMonth
ref table DimIndicator
ref table _Measures
ref table DimFunnelStage

ref cultureInfo en-US

